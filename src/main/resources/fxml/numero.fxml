<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
    xmlns="http://javafx.com/javafx/23"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.luisdbb.tarea3AD2024base.controller.NumeroController">

    <top>
        <VBox spacing="10.0" style="-fx-padding: 10;">
            <Label fx:id="lblEspectaculo" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Button text="← Volver" onAction="#volver"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaNumeros" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colOrden" text="Orden" prefWidth="80"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250"/>
                <TableColumn fx:id="colDuracion" text="Duración" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0" style="-fx-padding: 10;">
            <HBox spacing="10.0">
                <Label text="Orden:"/>
                <TextField fx:id="txtOrden" prefWidth="60"/>
                <Label text="Nombre:"/>
                <TextField fx:id="txtNombre" prefWidth="200"/>
                <Label text="Duración:"/>
                <TextField fx:id="txtDuracion" prefWidth="80"/>
            </HBox>
            <HBox spacing="10.0">
                <Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoNumero"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#guardarNumero"/>
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarNumero"/>
               
            </HBox>
            	<ListView fx:id="listaArtistas" prefHeight="150" prefWidth="200" style="-fx-padding: 10;"/>

        </VBox>
    </bottom>
</BorderPane>