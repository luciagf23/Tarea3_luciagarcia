<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="700.0"
    xmlns="http://javafx.com/javafx/23"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.luisdbb.tarea3AD2024base.controller.ArtistaController">

    <top>
        <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #2b2b3b;">
            <Label text="Mi Ficha" textFill="WHITE">
                <font><Font size="20.0"/></font>
            </Label>
            <Button text="← Volver" onAction="#volver"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" style="-fx-padding: 20;">

            <Label text="Datos personales" style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="8">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="120"/>
                    <ColumnConstraints prefWidth="250"/>
                </columnConstraints>
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="lblNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblEmail" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Nacionalidad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="lblNacionalidad" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Apodo:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="lblApodo" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Especialidades:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="lblEspecialidades" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Participaciones en espectáculos" 
                style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaNumeros" prefHeight="250.0">
                <columns>
                    <TableColumn fx:id="colEspectaculo" text="Espectáculo" prefWidth="250"/>
                    <TableColumn fx:id="colNumero" text="Número" prefWidth="250"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>